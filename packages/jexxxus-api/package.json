    "@huggingface/inference": "^4.13.15",
    "@supabase/supabase-js": "^2.38.4",
    "chromadb": "^1.9.2",
    "dotenv": "^16.6.1",
    "fastify": "^4.26.2",
    "langfuse": "^3.38.6",
    "msedge-tts": "^2.0.7",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "^3.5.0",
