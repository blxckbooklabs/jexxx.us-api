# JEXXXUS | API — copy to .env (never commit .env)
# Self-hosted OSS: see SECURITY.md and README.md

# --- Required for Live Account Vault (CLI / BLXCKCHAT / Hermes parity) ---
CLERK_SECRET_KEY=sk_live_...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Server must use direct Supabase — never HTTP-loop to itself
JEXXXUS_ACCOUNT_API=off

# --- Optional ---
# Super-admin vault elevation (comma-separated Clerk user IDs — env only, never hardcode)
JEXXXUS_SUPER_ADMIN_CLERK_IDS=user_xxx
# Service role — only for super-admin cross-user reads (never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=

# Route surface: vault (account+tools only) | full (legacy empire routes)
# JEXXXUS_API_SURFACE=vault

# CORS (comma-separated). Defaults include jexxx.us ecosystem origins.
# JEXXXUS_CORS_ORIGINS=http://localhost:3000,https://blxckchat.jexxx.us

# Clerk JWT hardening (optional — restrict azp / authorized parties)
# CLERK_AUTHORIZED_PARTIES=https://blxckchat.jexxx.us,https://blxckbook.jexxx.us

# Rate limits (per IP, per minute)
# JEXXXUS_RATE_LIMIT_MAX=120
# JEXXXUS_TOOL_RATE_LIMIT_MAX=30

# Legacy / AI routes (off by default in vault surface)
# JEXXXUS_ENABLE_LEGACY_ROUTES=true
# JEXXXUS_ENABLE_PUBLIC_AI_ROUTES=true
# JEXXXUS_ENABLE_OBSERVABILITY=true

PORT=8787
# JEXXXUS_API_ENV_FILE=/path/to/.env