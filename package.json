{
  "name": "blackbook-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @blackbook/app dev",
    "dev:all": "pnpm --recursive --parallel run dev",
    "build": "pnpm --filter @blackbook/app build",
    "build:vercel": "pnpm install && pnpm run build:workspaces && pnpm run build:app",
    "build:workspaces": "pnpm --filter=./packages/* run build",
    "build:app": "cd packages/blackbook-app && pnpm run build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "compress-assets": "node compress-assets.js",
    "upload-assets": "node upload-to-supabase.js",
    "generate-asset-mapping": "node generate-asset-mapping.js",
    "test:vector": "node test-vector-search.js",
    "test:vector:mock": "node test-vector-search-mock.js",
    "security-scan": "node security-scan.js",
    "pre-deploy": "npm run security-scan && npm run lint && npm run test && npm run test:ml-connection",
    "verify-env": "node verify-env.js",
    "setup-credentials": "node setup-credentials.js",
    "setup:admin-subdomain": "node scripts/setup-admin-subdomain.js",
    "setup:agent-tables": "node scripts/setup-agent-tables.js",
    "test:ml-providers": "node scripts/test-ml-providers.js",
    "test:config": "node test-config.js",
    "test:ml-connection": "node test-ml-connection.js",
    "test:openai": "node test-openai.js",
    "test:ml-complete": "node test-ml-integration.js",
    "test:ml": "node ml-simple-test.js",
    "test:xai": "node scripts/test-xai-integration.js",
    "test:ui-integration": "node scripts/test-ui-integration.js",
    "setup:vector": "node run-vector-setup.js",
    "setup:mcp": "node scripts/setup-mcp-server.js",
    "test:mcp": "node scripts/test-mcp-connection.js",
    "optimize-assets": "npm run compress-assets && npm run upload-assets",
    "docker:build": "docker build -t blackbook:latest .",
    "docker:slim": "docker-slim build --http-probe=false blackbook:latest",
    "fix:common": "node scripts/fix-common-errors.js",
    "fix:icons": "node scripts/fix-icon-imports.cjs",
    "fix:icon-components": "node scripts/fix-icon-components.js",
    "migrate:vercel": "node scripts/migrate-to-vercel.js",
    "serve:local": "vite --port 3000",
    "serve:simple-browser": "vite --port 3000 --open",
    "netlify:deploy": "npm run pre-deploy && npm run build:netlify",
    "prepare-github": "npm run fix:common && npm run optimize-assets",
    "deployment:check": "node scripts/deployment-check.js",
    "launch:simple-browser": "node scripts/launch-simple-browser.js",
    "fix:lucide-icons": "node scripts/fix-lucide-icons.js"
  },
  "dependencies": {
    "@clerk/clerk-react": "^4.32.5",
    "@clerk/themes": "^1.7.20",
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^9.11.0",
    "@sentry/tracing": "^7.120.3",
    "@storybook/addon-links": "^8.6.12",
    "@storybook/react-webpack5": "^8.6.12",
    "@tailwindcss/forms": "^0.x.x",
    "@tanstack/react-query": "^5.24.1",
    "@vercel/analytics": "1.5.0",
    "axios": "^1.x.x",
    "dayjs": "^1.11.7",
    "lucide-react": "^0.510.0",
    "openai": "^4.98.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-tooltip": "^5.28.0",
    "recharts": "^2.15.2",
    "remark-gfm": "^4.0.0",
    "sql.js-httpvfs": "^0.8.12",
    "typescript-eslint": "^8.29.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@cloudflare/workers-types": "^4.20250407.0",
    "@storybook/addon-a11y": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "^7.0.0",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@supabase/supabase-js": "^2.38.4",
    "@tailwindcss/postcss": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-router-dom": "^5.3.3",
    "@types/recharts": "^1.8.29",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.4.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "^8.0.0",
    "imagemin": "^8.0.1",
    "imagemin-avif": "^0.1.6",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.2",
    "imagemin-webp": "^8.0.0",
    "inquirer": "^9.2.16",
    "mime-types": "^2.1.35",
    "playwright": "^1.51.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "storybook": "^8.6.12",
    "svgo": "^3.0.2",
    "tailwindcss": "^4.1.3",
    "tailwindcss-cli": "^0.1.2",
    "typedoc": "^0.28.1",
    "typescript": "^5.3.3",
    "vite": "^6.2.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.1",
    "workbox-window": "^7.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
